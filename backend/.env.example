PORT=3001
NODE_ENV=development
# Relative paths resolve from backend/, regardless of the working directory.
ONTOLOGY_PATH=../ontology/assurance.owl
# Backend only. Never use a VITE_ variable for Fuseki configuration.
FUSEKI_QUERY_ENDPOINT=http://127.0.0.1:3030/assurance/query
SPARQL_TIMEOUT_MS=5000
CLAIMS_MUTATIONS_ENABLED=false
# Phase 4.5: session roles replace the retired demo-token mechanism.
# Leave RDF writes disabled until separately configured and verified.
FUSEKI_UPDATE_ENDPOINT=http://127.0.0.1:3030/assurance/update
FUSEKI_UPDATE_USERNAME=
FUSEKI_UPDATE_PASSWORD=
# Exact browser origin (use the same hostname in the browser).
APP_ORIGIN=http://127.0.0.1:5173
# Relative to backend/, outside committed sources. No runtime DB is committed.
AUTH_DATABASE_PATH=../.local/auth/auth.sqlite
# Set explicitly for local development only. No verification bypass is provided.
TURNSTILE_TEST_MODE=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
