{
  "name": "@assurance/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node dist/server.js",
    "test": "tsx --test test/*.test.ts",
    "test:unit": "tsx --test test/sparql.test.ts test/claims.test.ts test/resources.test.ts test/nlp.test.ts test/visualization.test.ts test/auth.test.ts",
    "auth:migrate": "tsx src/auth/cli.ts --migrate",
    "auth:bootstrap-admin": "tsx src/auth/cli.ts",
    "auth:recover-admin": "tsx src/auth/cli.ts --recover"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "natural": "^8.2.6",
    "rdfxml-streaming-parser": "^3.3.0"
  },
  "devDependencies": {
    "@rdfjs/types": "^2.0.1",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6"
  }
}
