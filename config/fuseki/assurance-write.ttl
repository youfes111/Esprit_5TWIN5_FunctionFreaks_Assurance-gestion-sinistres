@prefix fuseki: <http://jena.apache.org/fuseki#> .
@prefix tdb2: <http://jena.apache.org/2016/tdb#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# Opt-in local/demo profile. MUST be paired with shiro-write.ini, never Phase 1 shiro.ini.
# Use exactly the same FUSEKI_BASE and working directory as the read-only profile.
<#service> rdf:type fuseki:Service ;
    fuseki:name "assurance" ;
    fuseki:endpoint [ fuseki:operation fuseki:query ; fuseki:name "query" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:update ; fuseki:name "update" ] ;
    fuseki:dataset <#dataset> .
<#dataset> rdf:type tdb2:DatasetTDB2 ; tdb2:location "data/assurance" .
